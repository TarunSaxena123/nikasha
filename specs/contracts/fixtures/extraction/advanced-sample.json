{
 "items": [
  {
   "id": "i1",
   "status": "VAGUE",
   "field_label": "Expiry",
   "text": "The word weekly appears only in the title, so the expiry needs to be chosen.",
   "mandatory": true,
   "quote": "NIFTY 15-MIN WEEKLY OPTION BUYING"
  },
  {
   "id": "i2",
   "status": "VAGUE",
   "field_label": "Volatility (VIX) sizing",
   "text": "VIX is read at 09:00, before data starts at 09:15; the reading point must be chosen.",
   "mandatory": false,
   "quote": "Pre-Market Routine (09:00 AM) Check India VIX"
  },
  {
   "id": "i3",
   "status": "FOUND",
   "field_label": "Volatility (VIX) sizing",
   "text": "Below 12 trade 50% size; 12 to 18 trade 100% size.",
   "mandatory": false,
   "quote": "VIX < 12: High sideways risk. Cut normal position size by 50%. VIX 12–18: Ideal environment. Trade standard position size."
  },
  {
   "id": "i4",
   "status": "VAGUE",
   "field_label": "Volatility (VIX) sizing",
   "text": "Above 18 the size is reduced significantly, but no percentage is given.",
   "mandatory": false,
   "quote": "VIX > 18: High premium volatility. Reduce position size significantly."
  },
  {
   "id": "i5",
   "status": "FOUND",
   "field_label": "Indicators",
   "text": "Supertrend 10,2, EMA 9 and 21 on close, RSI 14 and ADX 14 on 15-minute candles.",
   "mandatory": false,
   "quote": "Supertrend: Period = 10, Multiplier = 2 EMA 1 (Fast): 9-period EMA 2 (Slow): 21-period RSI: 14-period ADX: 14-period"
  },
  {
   "id": "i6",
   "status": "VAGUE",
   "field_label": "Entry conditions",
   "text": "Unclear whether this means only the flip candle or any candle while Supertrend is green/red.",
   "mandatory": true,
   "quote": "Supertrend turns Green. / Supertrend turns Red."
  },
  {
   "id": "i7",
   "status": "FOUND",
   "field_label": "Entry conditions",
   "text": "9 EMA above 21 EMA for calls; below for puts.",
   "mandatory": true,
   "quote": "9 EMA is completely above the 21 EMA."
  },
  {
   "id": "i8",
   "status": "VAGUE",
   "field_label": "Entry conditions",
   "text": "Close above both EMAs (below for puts) by an unquantified margin.",
   "mandatory": true,
   "quote": "The trigger candle closes decisively above both EMAs."
  },
  {
   "id": "i9",
   "status": "FOUND",
   "field_label": "Entry conditions",
   "text": "RSI above 55 for calls and below 45 for puts.",
   "mandatory": true,
   "quote": "RSI is strictly above 55."
  },
  {
   "id": "i10",
   "status": "VAGUE",
   "field_label": "Entry conditions",
   "text": "ADX above 20 and rising, or above 30; the slope look-back is not stated.",
   "mandatory": true,
   "quote": "ADX is above 20 (Must slope up if between 20–30; slope does not matter if > 30)."
  },
  {
   "id": "i11",
   "status": "FOUND",
   "field_label": "Strike",
   "text": "Buy ITM options 100 points from spot (below for calls, above for puts).",
   "mandatory": true,
   "quote": "Buy In-The-Money (ITM) contract exactly 100 points below Nifty Spot."
  },
  {
   "id": "i12",
   "status": "VAGUE",
   "field_label": "SL cap",
   "text": "Stop is the trigger candle extreme, with a cap given as a range of 30 to 35 points.",
   "mandatory": false,
   "quote": "Capped at a maximum of 30–35 premium points."
  },
  {
   "id": "i13",
   "status": "FOUND",
   "field_label": "Target",
   "text": "Target is 1.5 times the stop distance.",
   "mandatory": true,
   "quote": "Target: Strict 1:1.5 Risk-to-Reward Ratio"
  },
  {
   "id": "i14",
   "status": "FOUND",
   "field_label": "Trail stop to cost",
   "text": "Move the stop to entry after a gain of 1 times the initial risk.",
   "mandatory": false,
   "quote": "Move SL to cost (break-even) once the premium gains a 1:1 risk-equivalent ratio."
  },
  {
   "id": "i15",
   "status": "FOUND",
   "field_label": "Exit after N candles",
   "text": "Exit after 4 candles if neither stop nor target is hit.",
   "mandatory": false,
   "quote": "If neither SL nor Target is hit within 60 minutes (4 candles), exit at market price instantly"
  },
  {
   "id": "i16",
   "status": "FOUND",
   "field_label": "No-entry windows",
   "text": "No new entries from 11:00 to 13:30.",
   "mandatory": false,
   "quote": "Do not open fresh positions between 11:00 AM and 01:30 PM"
  },
  {
   "id": "i17",
   "status": "VAGUE",
   "field_label": "Expiry-day cutoff",
   "text": "Thursday is used for expiry; Nifty expiry moved to Tuesday in September 2025, so confirm whether it means expiry day.",
   "mandatory": false,
   "quote": "Do not trade this strategy after 12:00 PM on Thursdays due to high Gamma risk."
  },
  {
   "id": "i18",
   "status": "FOUND",
   "field_label": "Daily limits",
   "text": "At most 2 trades per day, and stop for the day after 2 stop-loss hits.",
   "mandatory": false,
   "quote": "Maximum of 2 trades per day. Shut down your trading terminal immediately if both hit your SL."
  }
 ],
