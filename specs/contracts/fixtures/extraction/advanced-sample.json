{
 "items": [
  {
   "id": "i1",
   "status": "VAGUE",
   "field_label": "Volatility (VIX) sizing",
   "text": "VIX is read at 09:00, but market data starts at 09:15, so it is unclear when VIX should be measured.",
   "mandatory": false,
   "quote": "Pre-Market Routine (09:00 AM) Check India VIX to determine risk allocation before market open"
  },
  {
   "id": "i2",
   "status": "FOUND",
   "field_label": "Volatility (VIX) sizing",
   "text": "Size is 50% when VIX is below 12 and 100% when VIX is between 12 and 18.",
   "mandatory": false,
   "quote": "VIX < 12: ... Cut normal position size by 50%. VIX 12–18: ... Trade standard position size."
  },
  {
   "id": "i3",
   "status": "VAGUE",
   "field_label": "Volatility (VIX) sizing",
   "text": "Above 18 the size is reduced 'significantly', but the percentage of normal size is not stated.",
   "mandatory": false,
   "quote": "VIX > 18: High premium volatility. Reduce position size significantly."
  },
  {
   "id": "i4",
   "status": "VAGUE",
   "field_label": "Expiry",
   "text": "'Weekly' appears only in the title, so which expiry to trade is not stated.",
   "mandatory": true,
   "quote": "NIFTY 15-MIN WEEKLY OPTION BUYING STRATEGY"
  },
  {
   "id": "i5",
   "status": "VAGUE",
   "field_label": "Entry conditions",
   "text": "Unclear whether to act only on the candle where Supertrend flips or on any candle while it is in that colour.",
   "mandatory": true,
   "quote": "Supertrend turns Green. / Supertrend turns Red."
  },
  {
   "id": "i6",
   "status": "FOUND",
   "field_label": "Entry conditions",
   "text": "Call needs EMA 9 above EMA 21; put needs EMA 9 below EMA 21.",
   "mandatory": true,
   "quote": "9 EMA is completely above the 21 EMA. / 9 EMA is completely below the 21 EMA."
  },
  {
   "id": "i7",
   "status": "VAGUE",
   "field_label": "Entry conditions",
   "text": "Close must be above (call) or below (put) both EMAs 'decisively', but the margin is not stated.",
   "mandatory": true,
   "quote": "The trigger candle closes decisively above both EMAs."
  },
  {
   "id": "i8",
   "status": "FOUND",
   "field_label": "Entry conditions",
   "text": "Call needs RSI(14) above 55; put needs RSI(14) below 45.",
   "mandatory": true,
   "quote": "RSI is strictly above 55. / RSI is strictly below 45."
  },
  {
   "id": "i9",
   "status": "VAGUE",
   "field_label": "Entry conditions",
   "text": "ADX above 20 and rising, or above 30; the look-back for 'slope up' is not stated.",
   "mandatory": true,
   "quote": "ADX is above 20 (Must slope up if between 20–30; slope does not matter if > 30)."
  },
  {
   "id": "i10",
   "status": "FOUND",
   "field_label": "Strike",
   "text": "Buy ITM options 100 points from spot (call below spot, put above spot).",
   "mandatory": true,
   "quote": "Buy In-The-Money (ITM) contract exactly 100 points below Nifty Spot."
  },
  {
   "id": "i11",
   "status": "FOUND",
   "field_label": "Stop-loss",
   "text": "Stop-loss at the trigger candle's extreme on the option premium chart.",
   "mandatory": true,
   "quote": "Stop-Loss (SL): Low of the trigger candle on the Option Premium Chart."
  },
  {
   "id": "i12",
   "status": "VAGUE",
   "field_label": "SL cap",
   "text": "Stop distance is capped, but the cap is given as a range of 30 to 35 points.",
   "mandatory": false,
   "quote": "Capped at a maximum of 30–35 premium points."
  },
  {
   "id": "i13",
   "status": "FOUND",
   "field_label": "Target",
   "text": "Target is 1.5 times the stop distance.",
   "mandatory": true,
   "quote": "Target: Strict 1:1.5 Risk-to-Reward Ratio"
  },
  {
   "id": "i14",
   "status": "FOUND",
   "field_label": "Trail stop to cost",
   "text": "Move the stop to entry after a gain equal to 1x the initial risk.",
   "mandatory": false,
   "quote": "Move SL to cost (break-even) once the premium gains a 1:1 risk-equivalent ratio."
  },
  {
   "id": "i15",
   "status": "FOUND",
   "field_label": "Exit after N candles",
   "text": "Exit after 4 candles if neither stop nor target is hit.",
   "mandatory": false,
   "quote": "If neither SL nor Target is hit within 60 minutes (4 candles), exit at market price"
  },
  {
   "id": "i16",
   "status": "FOUND",
   "field_label": "No-entry windows",
   "text": "No new entries from 11:00 to 13:30.",
   "mandatory": false,
   "quote": "Do not open fresh positions between 11:00 AM and 01:30 PM"
  },
  {
   "id": "i17",
   "status": "VAGUE",
   "field_label": "Expiry-day cutoff",
   "text": "Rule uses 'Thursdays', but Nifty expiry moved from Thursday to Tuesday in September 2025; unclear if it means expiry day.",
   "mandatory": false,
   "quote": "Do not trade this strategy after 12:00 PM on Thursdays due to high Gamma risk."
  },
  {
   "id": "i18",
   "status": "FOUND",
   "field_label": "Daily limits",
   "text": "At most 2 trades per day, and stop for the day after 2 stop-loss hits.",
   "mandatory": false,
   "quote": "Maximum of 2 trades per day. Shut down your trading terminal immediately if both hit your SL."
  }
 ],
