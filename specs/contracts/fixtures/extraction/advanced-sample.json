{
 "items": [
  {
   "id": "i1",
   "status": "VAGUE",
   "field_label": "Expiry",
   "text": "The title says weekly, but which weekly or monthly contract isn't stated.",
   "mandatory": true,
   "quote": "NIFTY 15-MIN WEEKLY OPTION BUYING"
  },
  {
   "id": "i2",
   "status": "VAGUE",
   "field_label": "Volatility (VIX) sizing",
   "text": "India VIX is checked before the market opens; the data starts at 09:15.",
   "mandatory": false,
   "quote": "Pre-Market Routine (09:00 AM) Check India VIX to determine risk allocation before market open"
  },
  {
   "id": "i3",
   "status": "FOUND",
   "field_label": "Volatility (VIX) sizing",
   "text": "With India VIX below 12, trade 50% of the normal size.",
   "mandatory": false,
   "quote": "VIX < 12: High sideways risk. Cut normal position size by 50%."
  },
  {
   "id": "i4",
   "status": "FOUND",
   "field_label": "Volatility (VIX) sizing",
   "text": "With India VIX from 12 to 18, trade the normal size.",
   "mandatory": false,
   "quote": "VIX 12–18: Ideal environment. Trade standard position size."
  },
  {
   "id": "i5",
   "status": "VAGUE",
   "field_label": "Volatility (VIX) sizing",
   "text": "With India VIX above 18, the size is reduced, but by how much isn't stated.",
   "mandatory": false,
   "quote": "VIX > 18: High premium volatility. Reduce position size significantly."
  },
  {
   "id": "i6",
   "status": "FOUND",
   "field_label": "Candle timeframe",
   "text": "15-minute candles.",
   "mandatory": true,
   "quote": "Timeframe: 15-Minute"
  },
  {
   "id": "i7",
   "status": "FOUND",
   "field_label": "Indicators",
   "text": "Supertrend 10 × 2, EMA 9 and EMA 21 on the close, RSI 14 and ADX 14.",
   "mandatory": false,
   "quote": "Supertrend: Period = 10, Multiplier = 2 EMA 1 (Fast): 9-period, Source = Close EMA 2 (Slow): 21-period, Source = Close RSI: 14-period ADX: 14-period"
  },
  {
   "id": "i8",
   "status": "VAGUE",
   "field_label": "Entry conditions",
   "text": "Supertrend turning green (red for puts) is an entry condition.",
   "mandatory": true,
   "quote": "Supertrend turns Green."
  },
  {
   "id": "i9",
   "status": "FOUND",
   "field_label": "Entry conditions",
   "text": "EMA 9 is above EMA 21 for calls (below for puts).",
   "mandatory": true,
   "quote": "9 EMA is completely above the 21 EMA."
  },
  {
   "id": "i10",
   "status": "VAGUE",
   "field_label": "Entry conditions",
   "text": "The candle closes above both EMAs (below for puts) by an amount that isn't stated.",
   "mandatory": true,
   "quote": "The trigger candle closes decisively above both EMAs."
  },
  {
   "id": "i11",
   "status": "FOUND",
   "field_label": "Entry conditions",
   "text": "RSI 14 is above 55 for calls and below 45 for puts.",
   "mandatory": true,
   "quote": "RSI is strictly above 55."
  },
  {
   "id": "i12",
   "status": "FOUND",
   "field_label": "Entry conditions",
   "text": "ADX 14 is above 20 and rising, or above 30.",
   "mandatory": true,
   "quote": "ADX is above 20 (Must slope up if between 20–30; slope does not matter if > 30)."
  },
  {
   "id": "i13",
   "status": "VAGUE",
   "field_label": "Entry conditions",
   "text": "ADX must be rising, but compared with how many candles back isn't stated.",
   "mandatory": true,
   "quote": "Must slope up if between 20–30"
  },
  {
   "id": "i14",
   "status": "FOUND",
   "field_label": "Strike",
   "text": "Buy options 100 points in the money: a call on the call signal, a put on the put signal.",
   "mandatory": true,
   "quote": "Buy In-The-Money (ITM) contract exactly 100 points below Nifty Spot."
  },
  {
   "id": "i15",
   "status": "FOUND",
   "field_label": "Stop-loss",
   "text": "The stop-loss is at the trigger candle's low on the option premium.",
   "mandatory": true,
   "quote": "Stop-Loss (SL): Low of the trigger candle on the Option Premium Chart."
  },
  {
   "id": "i16",
   "status": "VAGUE",
   "field_label": "SL cap",
   "text": "The stop is capped, but at 30 or 35 points isn't decided.",
   "mandatory": false,
   "quote": "Capped at a maximum of 30–35 premium points."
  },
  {
   "id": "i17",
   "status": "FOUND",
   "field_label": "Target",
   "text": "The target is 1.5 times the stop distance.",
   "mandatory": true,
   "quote": "Target: Strict 1:1.5 Risk-to-Reward Ratio"
  },
  {
   "id": "i18",
   "status": "FOUND",
   "field_label": "Trail stop to cost",
   "text": "The stop moves to the entry price after a gain of 1 × the risk.",
   "mandatory": false,
   "quote": "Move SL to cost (break-even) once the premium gains a 1:1 risk-equivalent ratio."
  },
  {
   "id": "i19",
   "status": "FOUND",
   "field_label": "Exit after N candles",
   "text": "Exit after 4 candles if neither the stop nor the target is hit.",
   "mandatory": false,
   "quote": "If neither SL nor Target is hit within 60 minutes (4 candles), exit at market price"
  },
  {
   "id": "i20",
   "status": "FOUND",
   "field_label": "No-entry windows",
   "text": "No new entries from 11:00 to 13:30.",
   "mandatory": false,
   "quote": "Do not open fresh positions between 11:00 AM and 01:30 PM"
  },
  {
   "id": "i21",
   "status": "VAGUE",
   "field_label": "Expiry-day cutoff",
   "text": "No trades after 12:00 on Thursdays; Thursday was the expiry day until August 2025.",
   "mandatory": false,
   "quote": "Do not trade this strategy after 12:00 PM on Thursdays due to high Gamma risk."
  },
  {
   "id": "i22",
   "status": "FOUND",
   "field_label": "Daily limits",
   "text": "At most 2 trades a day; stop for the day after 2 stop-losses.",
   "mandatory": false,
   "quote": "Maximum of 2 trades per day. Shut down your trading terminal immediately if both hit your SL."
  }
 ],
