{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikasha.local/contracts/instrument.schema.json",
  "title": "InstrumentProfile",
  "description": "One instrument's configuration (product.md §8). The engine contains no instrument-specific logic; everything that differs between instruments is here (constitution §10). Profiles live in /instruments/*.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "identity", "session", "contract", "expiry", "underlying_type", "volatility", "pricing", "default_costs", "periods", "report", "allowed_timeframes_min", "data"],
  "properties": {
    "profile_version": { "const": "1.0" },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name", "exchange", "segment"],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Z0-9_]{2,20}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "exchange": { "enum": ["NSE", "BSE", "MCX", "TEST"] },
        "segment": { "type": "string", "minLength": 1, "maxLength": 40 },
        "timezone": { "const": "Asia/Kolkata" }
      }
    },

    "session": {
      "description": "Regular session(s). Several sessions allow e.g. MCX evening trading.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions", "first_bar", "last_bar", "intraday_squareoff"],
      "properties": {
        "sessions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["open", "close"],
            "properties": {
              "open": { "$ref": "#/$defs/Time" },
              "close": { "$ref": "#/$defs/Time" }
            }
          }
        },
        "first_bar": { "description": "Label of the first 1-minute bar of the day.", "$ref": "#/$defs/Time" },
        "last_bar": { "description": "Label of the last 1-minute bar of the day.", "$ref": "#/$defs/Time" },
        "intraday_squareoff": { "description": "Intraday positions are closed at this minute's open.", "$ref": "#/$defs/Time" }
      }
    },

    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strike_interval", "lot_size_suggested", "lot_size_note", "multiplier", "tick_size", "settlement"],
      "properties": {
        "strike_interval": { "type": "number", "exclusiveMinimum": 0 },
        "lot_size_suggested": { "description": "Pre-fill only; the user confirms or changes it.", "type": "integer", "minimum": 1 },
        "lot_size_note": { "description": "Plain-English note shown next to the pre-fill.", "type": "string" },
        "multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "tick_size": { "type": "number", "exclusiveMinimum": 0 },
        "settlement": { "enum": ["CASH_INTRINSIC_LAST_BAR_CLOSE"] }
      }
    },

    "expiry": {
      "description": "Dated expiry rules (product.md §7.4). Rules are matched by the scheduled expiry date.",
      "type": "object",
      "additionalProperties": false,
      "required": ["expiry_time", "rules", "holiday_rule", "extra_trading_days"],
      "properties": {
        "expiry_time": { "description": "Time of day at which contracts expire, used for time to expiry.", "$ref": "#/$defs/Time" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "weekday", "valid_from"],
            "properties": {
              "kind": { "enum": ["WEEKLY", "MONTHLY"] },
              "weekday": { "enum": ["MON", "TUE", "WED", "THU", "FRI"] },
              "position": { "description": "MONTHLY only: which weekday of the month.", "enum": ["LAST"] },
              "valid_from": { "description": "First scheduled expiry date this rule applies to (inclusive).", "type": "string", "format": "date" },
              "valid_to": { "description": "Last scheduled expiry date this rule applies to (inclusive); absent = still in force.", "type": "string", "format": "date" },
              "source": { "type": "string" }
            }
          }
        },
        "holiday_rule": { "enum": ["PREVIOUS_TRADING_DAY"] },
        "extra_trading_days": {
          "description": "Regular trading days absent from the data (e.g. sessions removed during cleaning). Counted as trading days so they never shift an expiry.",
          "type": "array",
          "items": { "type": "string", "format": "date" }
        }
      }
    },

    "underlying_type": { "enum": ["SPOT_INDEX", "FUTURES"] },

    "volatility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "name"],
      "properties": {
        "source": { "enum": ["INDEX_FILE", "HISTORICAL"] },
        "name": { "description": "Display name, e.g. India VIX.", "type": "string" },
        "historical_window_days": { "description": "HISTORICAL only.", "type": "integer", "minimum": 5 }
      }
    },

    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "risk_free_rate", "sensitivity_shift_pts"],
      "properties": {
        "provider": { "enum": ["BLACK_SCHOLES_VIX", "BLACK_76", "HISTORICAL_VOL"] },
        "risk_free_rate": { "description": "Annual, continuously compounded (e.g. 0.065).", "type": "number", "minimum": 0, "maximum": 0.5 },
        "sensitivity_shift_pts": { "description": "Volatility shift for the sensitivity reruns (± this many points).", "type": "number", "exclusiveMinimum": 0 }
      }
    },

    "default_costs": {
      "description": "Pre-filled evaluation-settings values (product.md §7.6); always shown for confirmation, never applied silently.",
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_on", "items"],
      "properties": {
        "verified_on": { "type": "string", "format": "date" },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brokerage_per_order", "stt_sell_pct", "stt_exercise_pct", "exchange_txn_pct", "sebi_per_crore", "stamp_buy_pct", "gst_pct", "slippage_pts"],
          "properties": {
            "brokerage_per_order": { "$ref": "#/$defs/CostItem" },
            "stt_sell_pct": { "$ref": "#/$defs/CostItem" },
            "stt_exercise_pct": { "$ref": "#/$defs/CostItem" },
            "exchange_txn_pct": { "$ref": "#/$defs/CostItem" },
            "sebi_per_crore": { "$ref": "#/$defs/CostItem" },
            "stamp_buy_pct": { "$ref": "#/$defs/CostItem" },
            "gst_pct": { "$ref": "#/$defs/CostItem" },
            "slippage_pts": { "$ref": "#/$defs/CostItem" }
          }
        }
      }
    },

    "periods": {
      "description": "Default backtest periods and the overfitting split per expiry kind (product.md §7.7). Dates absent at the end mean 'last date in the data'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["WEEKLY", "MONTHLY"],
      "properties": {
        "WEEKLY": { "$ref": "#/$defs/PeriodConfig" },
        "MONTHLY": { "$ref": "#/$defs/PeriodConfig" }
      }
    },

    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vol_band_edges", "regime"],
      "properties": {
        "vol_band_edges": { "description": "Ascending edges, e.g. [12, 18, 25] → <12, 12–18, 18–25, >25.", "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "regime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adx_period", "trending_min", "sideways_max"],
          "properties": {
            "adx_period": { "type": "integer", "minimum": 2 },
            "trending_min": { "type": "number" },
            "sideways_max": { "type": "number" }
          }
        }
      }
    },

    "allowed_timeframes_min": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": [1, 3, 5, 15, 30, 60, 240] }
    },

    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["underlying_file", "source"],
      "properties": {
        "underlying_file": { "description": "Path inside the engine image, relative to the data root.", "type": "string" },
        "volatility_file": { "description": "Required when volatility.source is INDEX_FILE.", "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "note"],
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "note": { "description": "Plain-English provenance and licence note shown in reports.", "type": "string" }
          }
        }
      }
    }
  },

  "$defs": {
    "Time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "CostItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "applies_to", "source"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "label": { "description": "Plain-English name shown to the user.", "type": "string" },
        "applies_to": { "description": "Plain-English description, e.g. 'Sell side, on premium'.", "type": "string" },
        "source": { "description": "Where the rate comes from, shown to the user.", "type": "string" }
      }
    },
    "PeriodConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_from", "in_sample", "out_of_sample_from"],
      "properties": {
        "available_from": { "description": "Earliest date this expiry kind can be backtested (e.g. weekly options launch).", "type": "string", "format": "date" },
        "in_sample": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "format": "date" },
            "to": { "type": "string", "format": "date" }
          }
        },
        "out_of_sample_from": { "type": "string", "format": "date" }
      }
    }
  },

  "examples": [
    {
      "profile_version": "1.0",
      "identity": { "symbol": "NIFTY50", "name": "Nifty 50", "exchange": "NSE", "segment": "Index options", "timezone": "Asia/Kolkata" },
      "session": {
        "sessions": [ { "open": "09:15", "close": "15:30" } ],
        "first_bar": "09:15",
        "last_bar": "15:29",
        "intraday_squareoff": "15:15"
      },
      "contract": {
        "strike_interval": 50,
        "lot_size_suggested": 65,
        "lot_size_note": "Current NSE Nifty lot size (revised from 75 in Jan 2026). Applied to the whole backtest.",
        "multiplier": 1,
        "tick_size": 0.05,
        "settlement": "CASH_INTRINSIC_LAST_BAR_CLOSE"
      },
      "expiry": {
        "expiry_time": "15:30",
        "rules": [
          { "kind": "MONTHLY", "weekday": "THU", "position": "LAST", "valid_from": "2015-01-01", "valid_to": "2025-08-31", "source": "NSE contract specification" },
          { "kind": "WEEKLY", "weekday": "THU", "valid_from": "2019-02-14", "valid_to": "2025-08-31", "source": "NSE weekly Nifty options launched 11 Feb 2019" },
          { "kind": "MONTHLY", "weekday": "TUE", "position": "LAST", "valid_from": "2025-09-01", "source": "NSE expiry-day revision effective 1 Sep 2025 (SEBI circular, May 2025)" },
          { "kind": "WEEKLY", "weekday": "TUE", "valid_from": "2025-09-01", "source": "NSE expiry-day revision effective 1 Sep 2025 (SEBI circular, May 2025)" }
        ],
        "holiday_rule": "PREVIOUS_TRADING_DAY",
        "extra_trading_days": ["2021-02-24", "2026-05-15"]
      },
      "underlying_type": "SPOT_INDEX",
      "volatility": { "source": "INDEX_FILE", "name": "India VIX" },
      "pricing": { "provider": "BLACK_SCHOLES_VIX", "risk_free_rate": 0.065, "sensitivity_shift_pts": 2 },
      "default_costs": {
        "verified_on": "2026-10-14",
        "items": {
          "brokerage_per_order": { "value": 20, "label": "Brokerage", "applies_to": "Each order, flat ₹ per order", "source": "Typical flat discount-broker fee (Nikasha assumption)" },
          "stt_sell_pct": { "value": 0.15, "label": "Securities Transaction Tax", "applies_to": "Sell side, % of premium", "source": "Finance Act 2026, effective 1 Apr 2026" },
          "stt_exercise_pct": { "value": 0.15, "label": "STT on exercise", "applies_to": "Bought options settled in the money at expiry, % of intrinsic value", "source": "Finance Act 2026, effective 1 Apr 2026" },
          "exchange_txn_pct": { "value": 0.03553, "label": "Exchange transaction charges", "applies_to": "Both sides, % of premium", "source": "NSE circular NSE/FA/73061 (27 Feb 2026) — to re-confirm" },
          "sebi_per_crore": { "value": 10, "label": "SEBI turnover fee", "applies_to": "Both sides, ₹ per crore of premium", "source": "SEBI regulatory fee" },
          "stamp_buy_pct": { "value": 0.003, "label": "Stamp duty", "applies_to": "Buy side, % of premium", "source": "Indian Stamp Act, as amended by Finance Act 2019" },
          "gst_pct": { "value": 18, "label": "GST", "applies_to": "% of brokerage + exchange charges + SEBI fee", "source": "CGST/IGST Acts, 2017" },
          "slippage_pts": { "value": 0.5, "label": "Slippage", "applies_to": "Each fill, premium points against you", "source": "Nikasha assumption (no order-book data)" }
        }
      },
      "periods": {
        "WEEKLY": { "available_from": "2019-02-11", "in_sample": { "from": "2019-02-11", "to": "2023-12-31" }, "out_of_sample_from": "2024-01-01" },
        "MONTHLY": { "available_from": "2015-01-09", "in_sample": { "from": "2015-01-09", "to": "2023-12-31" }, "out_of_sample_from": "2024-01-01" }
      },
      "report": { "vol_band_edges": [12, 18, 25], "regime": { "adx_period": 14, "trending_min": 25, "sideways_max": 20 } },
      "allowed_timeframes_min": [1, 3, 5, 15, 30, 60, 240],
      "data": {
        "underlying_file": "nifty50_1min.parquet",
        "volatility_file": "indiavix_1min.parquet",
        "source": {
          "name": "Kaggle: NSE - Nifty 50 Index Minute data (2015 to 2026)",
          "url": "https://www.kaggle.com/datasets/debashis74017/nifty-50-minute-data",
          "note": "Collected by the uploader from internet sources for research purposes; not an official NSE data feed. Used for non-commercial, educational purposes only."
        }
      }
    }
  ]
}
